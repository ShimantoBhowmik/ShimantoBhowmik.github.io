---
import '@fontsource-variable/anek-latin/wght.css';
import '../styles/global.css';
import latinFont from '@fontsource-variable/anek-latin/files/anek-latin-latin-wght-normal.woff2?url';
import banglaFont from '../fonts/anek-bangla-subset.woff2?url';
import { person } from '../data/profile';

interface Props {
  title?: string;
}

const { title = person.name } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={person.description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f2f4f4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={banglaFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={person.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Hide .reveal blocks only when they will be revealed: motion allowed and an observer exists.
      if (
        'IntersectionObserver' in window &&
        matchMedia('(prefers-reduced-motion: no-preference)').matches
      ) {
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Section lines, stems and .reveal blocks each play once, when they cross a line 20% above
      // the bottom of the screen.
      if (document.documentElement.classList.contains('reveal-ready')) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -20% 0px' },
        );
        document.querySelectorAll('.reveal, .section, .sh').forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
