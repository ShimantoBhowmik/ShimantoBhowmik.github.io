---
import Timeline from './Timeline.astro';
import { person, links } from '../data/profile';
---

<section class="hero" aria-labelledby="name">
  <div class="bar">
    <h1 class="who" id="name">
      {person.name}
      <span class="signature" lang="bn" aria-hidden="true">
        {person.nameBn}
      </span>
    </h1>
    <nav class="actions" aria-label="Contact and profiles">
      <a class="primary" href={`mailto:${person.email}`}>
        Email me
      </a>
      <a href={links.resume}>Resume</a>
      <a href={links.github}>GitHub</a>
      <a href={links.linkedin}>LinkedIn</a>
    </nav>
  </div>

  <p class="statement">{person.statement}</p>
  <p class="lede">{person.lede}</p>

  <Timeline />
</section>

<style>
  .hero {
    padding-top: clamp(20px, 3.5vw, 40px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 14px;
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  /* The name in Bangla, signed beside it in the world's green. */
  .signature {
    font-family: var(--font-bangla);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--green);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-weight: 500;
  }

  .actions .primary {
    font-weight: 650;
    text-decoration-color: var(--green);
    text-decoration-thickness: 3px;
  }

  /* The hero says what he does, at a size that holds the first screen on short laptops too. */
  .statement {
    max-width: 19ch;
    margin-top: clamp(48px, 9vh, 112px);
    font-size: clamp(2.5rem, min(5.4vw, 8.6vh), 5.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lede {
    max-width: 62ch;
    margin-top: clamp(16px, 2.2vh, 28px);
    font-size: var(--fs-lede);
    line-height: 1.35;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .hero :global(.timeline) {
    margin-top: clamp(8px, 2vh, 24px);
  }

  @media (max-width: 640px) {
    .hero :global(.timeline) {
      margin-top: 36px;
    }
  }
</style>
