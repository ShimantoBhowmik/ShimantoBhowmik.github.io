---
import { person, links, recent } from '../data/profile';
---

<section class="hero" aria-labelledby="name">
  <div class="top grid">
    <p class="lede">
      <strong>{person.name}</strong> {person.lede}
    </p>
    <nav class="actions" aria-label="Contact and profiles">
      <a class="primary" href={`mailto:${person.email}`}>
        Email me
      </a>
      <a href={links.resume}>Resume</a>
      <a href={links.github}>GitHub</a>
      <a href={links.linkedin}>LinkedIn</a>
    </nav>
  </div>

  <div class="hang">
    <h1 class="name" id="name">
      <span class="glyphs" lang="bn" aria-hidden="true">
        {person.nameBn}
      </span>
      <span class="sr-only">{person.name}</span>
    </h1>
    <ol class="cols" aria-label="Recent work">
      {recent.map((item, i) => (
        <li style={`--i: ${i}`}>
          <a href={`#${item.id}`}>
            <span class="org">{item.org}</span>
            <span class="years num">{item.years}</span>
            <span class="line">{item.line}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(24px, 4vw, 48px);
  }

  .top {
    align-items: start;
    row-gap: 24px;
  }

  .lede {
    grid-column: 1 / span 7;
    max-width: 34ch;
    font-size: var(--fs-lede);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .lede strong {
    color: var(--ink);
    font-weight: 600;
  }

  .actions {
    grid-column: 9 / -1;
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding-top: 0.35em;
    font-size: var(--fs-body);
    font-weight: 500;
  }

  .actions a {
    text-decoration-color: var(--rule);
  }

  .actions .primary {
    font-weight: 650;
    text-decoration-color: var(--green);
    text-decoration-thickness: 3px;
  }

  .actions a:hover {
    text-decoration-color: var(--green);
  }

  /* The name and everything under it hang from one line. */
  .hang {
    --name-size: clamp(3.25rem, 12.2vw, 12.5rem);
    --below-name: max(var(--name-size) * 0.16, 24px);
    position: relative;
    margin-top: clamp(56px, 11vh, 150px);
  }

  .name {
    position: relative;
    margin-inline: calc(-1 * var(--pad));
    padding-inline: var(--pad);
    font-family: var(--font-bangla);
    font-size: var(--name-size);
    font-weight: 600;
    line-height: 1;
    color: var(--green);
    white-space: nowrap;
  }

  /* Stems pass behind the letters with a clean break, the way a hand-drawn line crosses
     another: a ground-coloured rim painted under each glyph. The line sits on top of both. */
  .glyphs {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-left: var(--hang);
    -webkit-text-stroke: 0.08em var(--ground);
    paint-order: stroke fill;
  }

  .name::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    z-index: 2;
    top: var(--matra-line-top);
    height: var(--matra-line-height);
    background: currentColor;
    transform-origin: left center;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gutter);
    margin-top: var(--below-name);
  }

  .cols li {
    position: relative;
  }

  /* Each stem drops from the bottom of the line to the foot of its column. */
  .cols li::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(-1 * (var(--name-size) * (1 - var(--matra-bottom-ratio)) + var(--below-name)));
    bottom: 0;
    width: var(--stem);
    background: var(--green);
    transform-origin: top center;
    transition: width 220ms var(--ease-out);
  }

  /* The root of each stem sits above the letters so the knockout rim never parts it from the line. */
  .cols li::after {
    content: '';
    position: absolute;
    z-index: 2;
    left: 0;
    top: calc(-1 * (var(--name-size) * (1 - var(--matra-bottom-ratio)) + var(--below-name)));
    height: calc(var(--name-size) * 0.08);
    width: var(--stem);
    background: var(--green);
    transform-origin: top center;
    transition: width 220ms var(--ease-out);
  }

  .cols li:hover::after,
  .cols li:focus-within::after {
    width: 4px;
  }

  .cols li:hover::before,
  .cols li:focus-within::before {
    width: 4px;
  }

  .cols a {
    display: grid;
    gap: 2px;
    padding: 0 8px 4px 18px;
    text-decoration: none;
  }

  .org {
    font-size: var(--fs-title);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .years {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .line {
    margin-top: 10px;
    max-width: 30ch;
    color: var(--ink-2);
    line-height: 1.45;
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: no-preference) {
    .glyphs {
      animation: hang-in 700ms var(--ease-out) both;
    }

    .name::after {
      animation: draw 1200ms var(--ease-out) 380ms both;
    }

    .cols li::before,
    .cols li::after {
      animation: drop 800ms var(--ease-out) calc(900ms + var(--i) * 90ms) both;
    }
  }

  @keyframes hang-in {
    from {
      opacity: 0;
      transform: translateY(-0.05em);
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes drop {
    from {
      transform: scaleY(0);
    }
  }

  @media (max-width: 1080px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }

    .cols li:nth-child(n + 3)::before {
      top: -40px;
    }

    .cols li:nth-child(n + 3)::after {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .lede,
    .actions {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .actions {
      padding-top: 0;
    }
  }

  @media (max-width: 560px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }

    .cols li:nth-child(n + 2)::before {
      top: -28px;
    }

    .cols li:nth-child(n + 2)::after {
      display: none;
    }
  }
</style>
