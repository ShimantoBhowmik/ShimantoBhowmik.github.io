---
import type { Place } from '../data/profile';

interface Props {
  place: Place;
}

const { place } = Astro.props;
const solo = place.stints.length === 1;
---

<article
  class:list={['entry grid reveal', { solo }]}
  id={place.id}
  aria-labelledby={`${place.id}-org`}
>
  <header class="head rail">
    <h3 class="org" id={`${place.id}-org`}>
      {place.href ? <a href={place.href}>{place.org}</a> : place.org}
    </h3>
    <p class="meta">
      <span class="place-years">
        <span class="num">{place.years}</span> ·{' '}
      </span>
      {place.location}
    </p>
  </header>

  <div class="body content">
    {place.stints.map((stint) => (
      <section class="stint">
        <h4 class="focus">
          <span class="stint-years num">{stint.years}</span>
          <span class="focus-text">{stint.focus}</span>
        </h4>
        {stint.cite && <p class="cite">{stint.cite}</p>}
        {stint.detail && <p class="detail">{stint.detail}</p>}
        {stint.results.length > 0 && (
          <dl class="results">
            {stint.results.map((result) => (
              <div>
                <dt>{result.label}</dt>
                <dd class="num">{result.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {stint.link && (
          <p class="more">
            <a href={stint.link.href}>{stint.link.label}</a>
          </p>
        )}
      </section>
    ))}
  </div>
</article>

<style>
  .entry {
    position: relative;
    padding-block: clamp(28px, 3.2vw, 44px);
    row-gap: 16px;
  }

  .entry:first-of-type {
    padding-top: 0;
  }

  /* The stretch of the section's stem beside this entry thickens while it is being read. */
  .entry::before {
    content: '';
    position: absolute;
    z-index: 1;
    left: var(--stem-x);
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--green);
    transform: scaleX(0.375);
    transform-origin: left center;
    opacity: 0;
    transition:
      transform 220ms var(--ease-out),
      opacity 220ms var(--ease-out);
  }

  .entry:hover::before,
  .entry:focus-within::before {
    transform: scaleX(1);
    opacity: 1;
  }

  .org {
    font-size: var(--fs-title);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .org a {
    text-decoration: none;
  }

  .org a:hover {
    text-decoration: underline;
    text-decoration-color: var(--green);
  }

  .meta {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  /* Years move out of the rail into each stint's year column. */
  .place-years {
    display: none;
  }

  .body {
    display: grid;
    gap: clamp(28px, 3vw, 40px);
  }

  /* Every stint sets its years in one column beside the stem, so all titles start on one line,
     the way the Recognition ledger sets its years. */
  .stint {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    column-gap: 12px;
  }

  .stint > * {
    grid-column: 2;
  }

  .stint > .focus {
    position: relative;
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: baseline;
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .focus-text {
    max-width: 44ch;
    text-wrap: balance;
  }

  .stint-years {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--green);
  }

  /* Each stint is a stop on the section stem, drawn like the timeline's stops on its phone stem. */
  .focus::before {
    content: '';
    position: absolute;
    z-index: 2;
    left: calc(-1 * var(--hang) + var(--stem) / 2 - 7px);
    top: calc(0.65em - 7px);
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--ground);
    transition:
      border-color 220ms var(--ease-out),
      background-color 220ms var(--ease-out);
  }

  .entry:hover .focus::before,
  .entry:focus-within .focus::before {
    border-color: var(--green);
    background: var(--green);
  }

  .cite {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .detail {
    margin-top: 10px;
    max-width: 66ch;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .results {
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(28px, 4vw, 56px);
    margin-top: 18px;
  }

  .results div {
    display: flex;
    flex-direction: column-reverse;
  }

  .results dd {
    font-size: var(--fs-value);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .results dt {
    font-size: var(--fs-small);
    color: var(--ink-3);
  }

  .more {
    margin-top: 16px;
    font-weight: 600;
  }

  .more a {
    text-decoration-color: var(--green);
  }

  /* Phones have no room for the year column: the place keeps its years in the rail, and only a
     place with several stints labels each one inline. */
  @media (max-width: 640px) {
    .place-years {
      display: inline;
    }

    .stint {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 14px;
    }

    .stint > * {
      grid-column: 1 / -1;
    }

    .solo .stint-years {
      display: none;
    }

    .solo .focus-text {
      grid-column: 1 / -1;
    }
  }
</style>
